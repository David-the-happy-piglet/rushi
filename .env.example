# 复制为 .env（已 git-ignore）或 ~/.rushi/.env 后填写。真实环境变量优先。
# 永远不要把真实 key 提交进仓库。

# ---- 选择模型后端：anthropic | openai | mock ----
RUSHI_LLM=openai

# ---- OpenAI 兼容接口（MiniMax / DeepSeek / Ollama / vLLM …）----
# MiniMax 国际站：https://api.minimax.io/v1    国内站：https://api.minimaxi.com/v1
RUSHI_OPENAI_BASE=https://api.minimax.io/v1
RUSHI_MODEL=MiniMax-M2.7
RUSHI_API_KEY=

# 本地 Ollama 示例：
# RUSHI_OPENAI_BASE=http://localhost:11434/v1
# RUSHI_MODEL=qwen3:8b

# ---- Anthropic（RUSHI_LLM=anthropic 时）----
# ANTHROPIC_API_KEY=
# RUSHI_MODEL=claude-sonnet-4-6
